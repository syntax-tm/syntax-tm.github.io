{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": false,
    "noImplicitAny": true,
    "allowSyntheticDefaultImports": true,
    "removeComments": true,
    "newLine": "lf",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@app/*": [
        "./src/app/*"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@context/*": [
        "./src/context/*"
      ],
      "@models/*": [
        "./src/models/*"
      ],
      "@providers/*": [
        "./src/providers/*"
      ],
      "@services/*": [
        "./src/services/*"
      ],
      "@hooks/*": [
        "./src/hooks/*"
      ],
      "@styles/*": [
        "./src/styles/*"
      ],
      "public/*": [
        "./public/*"
      ],
      "image/*": [
        "./public/image/*"
      ],
      "svg/*": [
        "./public/svg/*"
      ],
      "@config/*": [
        "./public/config/*"
      ],
      "@audio/*": [
        "./public/audio/*"
      ],
      "audio/*": [
        "./public/audio/*"
      ],
      "fonts/*": [
        "./public/fonts/*"
      ],
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "src/**/*.d.ts",
    ".next/dev/types/**/*.ts",
  ],
  "exclude": [
    "node_modules",
    "./tsconfig.json",
  ]
}
